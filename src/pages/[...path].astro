---
import { getCollection } from 'astro:content';
import type { Locale } from '@/content.config';
import { LOCALES, DEFAULT_LOCALE, homePath, routePath, experiencePath } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/design/SiteHeader.astro';
import Footer from '@/components/design/SiteFooter.astro';
import Home from '@/components/design/Landing.astro';
import About from '@/components/design/AboutSections.astro';
import Faq from '@/components/design/FaqSection.astro';
import ExperienceDetail from '@/components/pages/ExperienceDetail.astro';
import ExperiencesIndex from '@/components/pages/ExperiencesIndex.astro';
import { useTranslations } from '@/i18n';

/**
 * Una sola ruta atrapa todo el sitio porque el segmento cambia de idioma a
 * idioma (/quienes-somos, /en/about-us, /pt/quem-somos). Con archivos sueltos
 * habría que duplicar una página por idioma y por sección; aquí la tabla de
 * abajo es la única fuente de verdad y hreflang sale de ella sin poder
 * desincronizarse.
 */
export async function getStaticPaths() {
  const experiences = await getCollection('experiences');
  type Kind = 'home' | 'about' | 'faq' | 'experiences' | 'experience';

  const pages: { kind: Kind; slug?: string; paths: Record<Locale, string> }[] = [
    { kind: 'home', paths: byLocale((l) => homePath(l)) },
    { kind: 'about', paths: byLocale((l) => routePath('about', l)) },
    { kind: 'faq', paths: byLocale((l) => routePath('faq', l)) },
    // Catálogo completo: es a donde apunta "Experiencias" del menú.
    { kind: 'experiences', paths: byLocale((l) => routePath('experiences', l)) },
    ...experiences.map((entry) => ({
      kind: 'experience' as Kind,
      slug: entry.data.slug,
      paths: byLocale((l) => experiencePath(entry.data.slug, l)),
    })),
  ];

  function byLocale(fn: (l: Locale) => string): Record<Locale, string> {
    return Object.fromEntries(LOCALES.map((l) => [l, fn(l)])) as Record<Locale, string>;
  }

  return pages.flatMap((page) =>
    LOCALES.map((locale) => ({
      // El catch-all recibe la ruta sin la barra inicial; '' produce la home.
      params: { path: page.paths[locale].replace(/^\//, '') || undefined },
      props: { kind: page.kind, locale, slug: page.slug, alternates: page.paths },
    })),
  );
}

const { kind, locale, slug, alternates } = Astro.props as {
  kind: 'home' | 'about' | 'faq' | 'experiences' | 'experience';
  locale: Locale;
  slug?: string;
  alternates: Record<Locale, string>;
};

const t = useTranslations(locale);
const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);
const entry = slug ? experiences.find((e) => e.data.slug === slug) : undefined;
if (kind === 'experience' && !entry) throw new Error(`experiencia no encontrada: ${slug}`);

const META: Record<string, { title: string; description: string }> = {
  home: {
    title: t('meta.home.title'),
    description: t('meta.home.description'),
  },
  about: { title: t('meta.about.title'), description: t('meta.about.description') },
  faq: { title: t('meta.faq.title'), description: t('meta.faq.description') },
  experiences: { title: t('meta.experiences.title'), description: t('meta.experiences.description') },
  experience: entry
    ? {
        title: `${entry.data.content[locale].title} · PatagoniK`,
        description: entry.data.content[locale].lead,
      }
    : { title: 'PatagoniK', description: '' },
};

const meta = META[kind]!;
---

<BaseLayout locale={locale} page={kind} title={meta.title} description={meta.description} alternates={alternates}>
  <Header slot="header" locale={locale} />
  {kind === 'home' && <Home locale={locale} />}
  {kind === 'about' && <About locale={locale} />}
  {kind === 'faq' && <Faq locale={locale} />}
  {kind === 'experiences' && <ExperiencesIndex locale={locale} experiences={experiences} />}
  {kind === 'experience' && entry && <ExperienceDetail locale={locale} entry={entry} />}
  <Footer slot="footer" locale={locale} />
</BaseLayout>
