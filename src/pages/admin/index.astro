  .asset-card__media img, .asset-card__media video { position: absolute; z-index: 1; display: block; max-width: none; max-height: none; will-change: left, top, width, height; }
  .asset-card__preview[data-drag-enabled="true"] .asset-card__media { cursor: grab; touch-action: none; }
  .asset-card__preview[data-dragging="true"] .asset-card__media { cursor: grabbing; box-shadow: 0 22px 50px rgba(38, 48, 42, .29), 0 0 0 3px rgba(83, 99, 73, .32); }
  .asset-card__preview[data-drag-enabled="true"] .asset-card__media img,
  .asset-card__preview[data-drag-enabled="true"] .asset-card__media video { pointer-events: none; user-select: none; }
  .asset-card__badges { position: absolute; z-index: 2; top: .8rem; right: .8rem; left: .8rem; display: flex; justify-content: space-between; gap: .5rem; pointer-events: none; }
  .asset-card__drag-hint { position: absolute; z-index: 4; bottom: 14px; left: 12px; display: inline-flex; align-items: center; gap: .4rem; min-height: 32px; max-width: calc(100% - 142px); padding: .38rem .68rem; border: 1px solid rgba(255, 255, 255, .55); border-radius: 999px; color: #fff; background: rgba(33, 41, 36, .78); box-shadow: 0 5px 15px rgba(0, 0, 0, .14); pointer-events: none; transition: color .18s ease, background .18s ease, border-color .18s ease, transform .18s ease; backdrop-filter: blur(8px); font-size: .66rem; font-weight: 760; white-space: nowrap; }
