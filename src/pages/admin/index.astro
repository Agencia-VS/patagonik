  .asset-card__frame-label { position: absolute; z-index: 3; right: 12px; bottom: 17px; padding: .3rem .5rem; border: 1px solid rgba(65, 79, 59, .14); border-radius: 7px; color: #515c53; background: rgba(246, 246, 240, .82); backdrop-filter: blur(8px); font-size: .59rem; font-weight: 800; letter-spacing: .04em; pointer-events: none; text-transform: uppercase; }
  .state-badge, .type-badge { padding: .34rem .58rem; border: 1px solid rgba(255, 255, 255, .55); border-radius: 999px; color: #344138; background: rgba(250, 249, 245, .9); box-shadow: 0 3px 12px rgba(38, 48, 42, .13); backdrop-filter: blur(8px); font-size: .64rem; font-weight: 800; }
  .state-badge[data-state="draft"] { color: #744e13; background: rgba(255, 244, 219, .94); }
  .state-badge[data-state="published"] { color: #35603c; background: rgba(229, 242, 230, .94); }
  .preview-switch { display: flex; align-items: center; justify-content: flex-end; gap: .35rem; min-height: 44px; padding: .45rem .75rem; border-bottom: 1px solid #dfe0da; background: #f2f2ec; }
