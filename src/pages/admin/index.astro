  .asset-card__preview::before { position: absolute; z-index: 0; inset: 0; opacity: .42; pointer-events: none; background-image: linear-gradient(rgba(64, 78, 68, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(64, 78, 68, .08) 1px, transparent 1px); background-size: 24px 24px; content: ""; }
  .asset-card__media { position: relative; z-index: 1; isolation: isolate; display: grid; place-items: center; width: min(100%, 440px); aspect-ratio: var(--preview-aspect-ratio, 4 / 3); overflow: hidden; border: 2px solid rgba(255, 255, 255, .92); border-radius: 3px; color: rgba(255, 255, 255, .8); background-color: #303833; background-image: linear-gradient(45deg, rgba(255, 255, 255, .035) 25%, transparent 25%, transparent 75%, rgba(255, 255, 255, .035) 75%), linear-gradient(45deg, rgba(255, 255, 255, .035) 25%, transparent 25%, transparent 75%, rgba(255, 255, 255, .035) 75%); background-position: 0 0, 10px 10px; background-size: 20px 20px; box-shadow: 0 18px 44px rgba(38, 48, 42, .22), 0 0 0 1px rgba(46, 57, 49, .22); font-size: .78rem; transition: box-shadow .18s ease; }
