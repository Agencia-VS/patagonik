  .asset-card__preview[data-frame-shape="modal-side"]::after { position: absolute; z-index: 0; top: 50%; left: 50%; width: min(33%, 150px); aspect-ratio: 2 / 5; border: 1px solid rgba(65, 79, 59, .12); background-color: #f7f4ed; background-image: linear-gradient(#d6d1c6 0 0), linear-gradient(#d6d1c6 0 0), linear-gradient(#e3ded4 0 0), linear-gradient(#e3ded4 0 0), linear-gradient(#e3ded4 0 0); background-position: 18px 28px, 18px 49px, 18px 88px, 18px 105px, 18px 122px; background-repeat: no-repeat; background-size: 65% 9px, 44% 5px, calc(100% - 36px) 3px, 72% 3px, 84% 3px; box-shadow: 0 18px 44px rgba(38, 48, 42, .15); content: ""; transform: translateY(-50%); }
  .asset-card__media::after { position: absolute; z-index: 4; inset: 8px; border: 1px solid rgba(255, 255, 255, .52); opacity: .72; pointer-events: none; background-image: linear-gradient(to right, transparent calc(33.333% - .5px), rgba(255, 255, 255, .38) 33.333%, transparent calc(33.333% + .5px), transparent calc(66.667% - .5px), rgba(255, 255, 255, .38) 66.667%, transparent calc(66.667% + .5px)), linear-gradient(to bottom, transparent calc(33.333% - .5px), rgba(255, 255, 255, .38) 33.333%, transparent calc(33.333% + .5px), transparent calc(66.667% - .5px), rgba(255, 255, 255, .38) 66.667%, transparent calc(66.667% + .5px)); content: ""; transition: opacity .18s ease; }
  .asset-card__preview[data-preview-kind="hero"] .asset-card__media::before { position: absolute; z-index: 3; inset: 0; display: grid; place-items: center; padding-bottom: 8%; color: rgba(245, 242, 236, .92); background: linear-gradient(180deg, rgba(20, 24, 28, .5), rgba(20, 24, 28, .16) 42%, rgba(20, 24, 28, .58)); content: "PatagoniK"; pointer-events: none; font: 400 clamp(.8rem, 2vw, 1.25rem)/1 Georgia, serif; letter-spacing: .2em; text-shadow: 0 3px 18px rgba(0, 0, 0, .4); }
  .asset-card__preview[data-preview-kind="final-cta"] .asset-card__media::before { position: absolute; z-index: 3; inset: 0; display: flex; align-items: flex-end; padding: 12%; color: rgba(245, 242, 236, .88); background: linear-gradient(180deg, rgba(18, 22, 26, .42), rgba(18, 22, 26, .12) 45%, rgba(18, 22, 26, .7)); content: "PATAGONIA\A TE ESPERA"; pointer-events: none; font: 400 clamp(.55rem, 1.6vw, .9rem)/1.15 Georgia, serif; letter-spacing: .08em; white-space: pre; }
  .asset-card__preview[data-drag-enabled="true"] .asset-card__media:hover::after,
