---
export const prerender = true;

const adminConfig = {
  supabaseUrl: (import.meta.env.PUBLIC_SUPABASE_URL ?? '').replace(/\/$/, ''),
  supabaseKey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
  cloudName: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME ?? '',
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="theme-color" content="#eeece5" />
    <title>Panel de administración · PatagoniK</title>
    <script type="application/json" id="pk-admin-config" set:html={JSON.stringify(adminConfig).replace(/</g, '\\u003c')}></script>
  </head>
  <body data-admin-view="login">
    <main>
      <section id="login-view" class="login" aria-labelledby="login-title">
        <div class="panel login__panel">
          <div class="login__mark" aria-hidden="true">PK</div>
          <p class="eyebrow">PatagoniK</p>
          <h1 id="login-title">Panel de administración</h1>
          <p class="login__lead">Aquí se gestionan las experiencias y los recursos gráficos de la página.</p>

          <form id="login-form" class="login__form">
            <label class="field">
              <span>Correo electrónico</span>
              <input name="email" type="email" autocomplete="username" placeholder="admin@patagonik.cl" required />
            </label>
            <label class="field">
              <span>Contraseña</span>
              <input name="password" type="password" autocomplete="current-password" placeholder="Tu contraseña" required />
            </label>
            <button type="submit" class="button button--primary button--wide">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" /></svg>
              <span>Entrar al panel</span>
            </button>
          </form>
          <p id="login-status" class="status status--login" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section id="dashboard-view" class="dashboard" aria-labelledby="dashboard-title" hidden>
        <header class="toolbar">
          <div class="toolbar__identity">
            <div class="toolbar__mark" aria-hidden="true">PK</div>
            <div>
              <p class="eyebrow">Panel de administración</p>
              <h1 id="dashboard-title" tabindex="-1">Contenido y recursos</h1>
              <p class="toolbar__help">Crea experiencias, define su prioridad y publica los recursos de cada sección.</p>
            </div>
          </div>
          <div class="toolbar__actions">
            <button id="refresh-button" type="button" class="button button--secondary">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.3 6.2A6 6 0 1 0 16 12M15.3 6.2V2.8m0 3.4h-3.4" /></svg>
              <span>Actualizar</span>
            </button>
            <button id="logout-button" type="button" class="button button--quiet">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M8 4H4v12h4m3-3 3-3-3-3m3 3H7" /></svg>
              <span>Salir</span>
            </button>
            <button id="publish-button" type="button" class="button button--primary">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 14V3m-4 4 4-4 4 4M4 12v4h12v-4" /></svg>
              <span>Publicar cambios</span>
            </button>
          </div>
        </header>

        <div class="dashboard__content">
          <div class="dashboard__feedback">
            <div id="draft-count" class="draft-count" data-empty="true">
              <span class="draft-count__dot" aria-hidden="true"></span>
              <span>Sin cambios pendientes</span>
            </div>
            <p id="dashboard-status" class="status status--dashboard" role="status" aria-live="polite"></p>
          </div>

          <nav class="section-nav" aria-label="Secciones de la página">
            <div class="section-nav__intro">
              <p class="eyebrow">Secciones</p>
              <p>Elige una sección para administrar sus recursos.</p>
            </div>
            <div id="section-tabs" class="section-tabs" role="tablist" aria-label="Recursos por sección">
              <button id="section-tab-hero" class="section-tab" type="button" role="tab" aria-selected="true" aria-controls="asset-grid" data-section-tab="hero">
                <span>Hero</span><span class="section-tab__count" data-section-count="hero">0</span>
              </button>
              <button id="section-tab-experiences" class="section-tab" type="button" role="tab" aria-selected="false" aria-controls="asset-grid" tabindex="-1" data-section-tab="experiences">
                <span>Experiencias</span><span class="section-tab__count" data-section-count="experiences">0</span>
              </button>
              <button id="section-tab-essence" class="section-tab" type="button" role="tab" aria-selected="false" aria-controls="asset-grid" tabindex="-1" data-section-tab="essence">
                <span>Nuestra esencia</span><span class="section-tab__count" data-section-count="essence">0</span>
              </button>
              <button id="section-tab-closing" class="section-tab" type="button" role="tab" aria-selected="false" aria-controls="asset-grid" tabindex="-1" data-section-tab="closing">
                <span>Cierre</span><span class="section-tab__count" data-section-count="closing">0</span>
              </button>
            </div>
          </nav>

          <header class="section-heading">
            <div>
              <p id="section-kicker" class="eyebrow">Portada y transición</p>
              <h2 id="section-title">Hero</h2>
              <p id="section-description">Recursos principales que reciben al visitante al entrar al sitio.</p>
            </div>
            <div class="section-total"><strong id="section-visible-count">0</strong><span>recursos</span></div>
          </header>

          <section id="experience-manager" class="experience-manager" aria-labelledby="experience-manager-title" hidden>
            <header class="experience-manager__head">
              <div>
                <p class="eyebrow">Contenido y prioridad</p>
                <h3 id="experience-manager-title">Orden de experiencias</h3>
                <p>Este orden se usa tanto en la portada como en el catálogo. En computador puedes arrastrar; en celular usa Subir y Bajar.</p>
              </div>
              <button id="new-experience-button" type="button" class="button button--primary">
                <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
                <span>Nueva experiencia</span>
              </button>
            </header>
            <p id="experience-manager-status" class="status" role="status" aria-live="polite"></p>
            <ol id="experience-list" class="experience-list" aria-label="Orden de experiencias"></ol>
            <p class="experience-manager__note">Las experiencias nuevas permanecen como borrador hasta que tengan contenido en los tres idiomas, una portada y se pulse “Publicar cambios”.</p>
          </section>

          <div id="asset-grid" class="asset-grid" role="tabpanel" aria-labelledby="section-tab-hero" aria-live="polite"></div>
        </div>
      </section>
    </main>

    <dialog id="experience-dialog" class="experience-dialog" aria-labelledby="experience-dialog-title">
      <form id="experience-form" class="experience-editor">
        <header class="experience-editor__head">
          <div>
            <p class="eyebrow">Card · modal · página individual</p>
            <h2 id="experience-dialog-title">Nueva experiencia</h2>
          </div>
          <button id="experience-dialog-close" type="button" class="experience-editor__close" aria-label="Cerrar editor">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </header>

        <input id="experience-id" type="hidden" />
        <div class="experience-editor__meta">
          <label class="field">
            <span>URL (slug)</span>
            <input id="experience-slug" type="text" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="trekking-laguna-amarga" required />
            <small>Se genera desde el título; puedes ajustarla antes de crear. Luego no cambia.</small>
          </label>
          <label class="field">
            <span>Estado del borrador</span>
            <select id="experience-status">
              <option value="active">Activa</option>
              <option value="archived">Archivada</option>
            </select>
            <small>Archivar la oculta en la próxima publicación.</small>
          </label>
        </div>

        <div class="locale-tabs" role="tablist" aria-label="Idioma del contenido">
          <button type="button" role="tab" aria-selected="true" data-experience-locale="es">Español <span>Original</span></button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1" data-experience-locale="en">English <span>Editable</span></button>
          <button type="button" role="tab" aria-selected="false" tabindex="-1" data-experience-locale="pt">Português <span>Editable</span></button>
        </div>
        <div id="experience-locale-panels" class="experience-locale-panels"></div>

        <footer class="experience-editor__footer">
          <p id="experience-form-status" class="status" role="status" aria-live="polite"></p>
          <div class="experience-editor__actions">
            <button id="translate-experience-button" type="button" class="button button--secondary">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h8M8 3v2c0 4-2 7-5 9m3-4c1 2 3 4 5 5m2-8 4 10m-1-3h-6" /></svg>
              <span>Generar EN/PT</span>
            </button>
            <button id="cancel-experience-button" type="button" class="button button--quiet">Cancelar</button>
            <button id="save-experience-button" type="submit" class="button button--primary">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3 3 7-7" /></svg>
              <span>Guardar borrador</span>
            </button>
          </div>
        </footer>
      </form>
    </dialog>

    <dialog id="delete-experience-dialog" class="confirm-dialog" aria-labelledby="delete-experience-title" aria-describedby="delete-experience-description">
      <div class="confirm-dialog__content">
        <div class="confirm-dialog__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3m-8 0 1 13h8l1-13M10 11v5m4-5v5" /></svg>
        </div>
        <p class="eyebrow">Acción permanente</p>
        <h2 id="delete-experience-title">Eliminar experiencia</h2>
        <p id="delete-experience-description">Vas a eliminar <strong id="delete-experience-name"></strong> del panel. Se retirará de la portada, el catálogo y su página individual cuando publiques los cambios.</p>
        <p class="confirm-dialog__note">La imagen original no se borra de Cloudinary.</p>
        <p id="delete-experience-status" class="status" role="status" aria-live="polite"></p>
        <div class="confirm-dialog__actions">
          <button id="cancel-delete-experience-button" type="button" class="button button--secondary">Cancelar</button>
          <button id="confirm-delete-experience-button" type="button" class="button button--danger">
            <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 6V3h4v3m-6 0 1 11h6l1-11M8.5 9v5m3-5v5" /></svg>
            <span>Eliminar experiencia</span>
          </button>
        </div>
      </div>
    </dialog>

    <template id="asset-card-template">
      <article class="asset-card">
        <div class="asset-card__preview">
          <div class="asset-card__media" data-preview-media></div>
          <div class="asset-card__badges">
            <span class="state-badge" data-state></span>
            <span class="type-badge" data-resource-label></span>
          </div>
          <div class="asset-card__drag-hint" data-drag-hint aria-hidden="true">
            <svg viewBox="0 0 20 20"><path d="M10 3v14M3 10h14M7 6l3-3 3 3M7 14l3 3 3-3M6 7l-3 3 3 3M14 7l3 3-3 3" /></svg>
            <span data-drag-hint-text>Mantén presionado y arrastra la foto</span>
          </div>
          <span class="asset-card__frame-label" data-frame-label>Vista real · 4:3</span>
        </div>
        <div class="preview-switch" role="group" aria-label="Formato de vista previa">
          <span>¿Dónde quieres revisar?</span>
          <button type="button" data-preview-context="desktop" aria-pressed="true">Card escritorio</button>
          <button type="button" data-preview-context="mobile" aria-pressed="false">Card móvil</button>
          <button type="button" data-preview-context="modal" aria-pressed="false" hidden>Modal</button>
        </div>

        <form class="asset-card__form" data-asset-form>
          <header class="asset-card__heading">
            <p data-slot-key></p>
            <h3 data-label></h3>
          </header>

          <section class="replacement" aria-label="Reemplazar recurso">
            <div class="replacement__heading">
              <h4>Reemplazar recurso</h4>
              <p>Sube un archivo o utiliza un recurso existente de Cloudinary.</p>
            </div>
            <label class="field file-field">
              <span>Archivo nuevo</span>
              <input data-file type="file" accept="image/*,video/mp4,video/webm" />
            </label>
            <div class="source-divider"><span>o usar Cloudinary</span></div>
            <div class="source-fields">
              <label class="field field--source">
                <span>URL o public ID</span>
                <input data-public-id type="text" spellcheck="false" placeholder="patagonik/landing/recurso" />
              </label>
              <label class="field field--type">
                <span>Tipo</span>
                <select data-resource-type><option value="image">Imagen</option><option value="video">Video</option></select>
              </label>
            </div>
          </section>

          <details class="asset-card__settings">
            <summary><span>Encuadre y accesibilidad</span><small>Preview en vivo</small></summary>
            <div class="settings-body">
              <section class="framing" aria-label="Cómo se muestra">
                <div class="settings-heading">
                  <h4>Cómo se muestra</h4>
                  <p>Prueba el ajuste y la posición sin modificar el archivo original.</p>
                </div>
                <input data-fit type="hidden" value="cover" />
                <div class="fit-options" role="group" aria-label="Ajuste del recurso">
                  <button type="button" data-fit-option="cover" aria-pressed="true">
                    <strong>Rellenar</strong><span>Ocupa todo el marco</span>
                  </button>
                  <button type="button" data-fit-option="contain" aria-pressed="false">
                    <strong>Ver completo</strong><span>Sin recortar</span>
                  </button>
                </div>
                <div class="position-control">
                  <div class="position-control__heading">
                    <span>Posición en el marco</span>
                    <output data-focal-label>Card escritorio · Centro</output>
                  </div>
                  <input data-focal="x" type="hidden" value="0.5" />
                  <input data-focal="y" type="hidden" value="0.5" />
                  <p class="position-control__help">Arrastra la foto directamente en la vista previa superior hasta dejar visible la parte que quieres mostrar.</p>
                  <button type="button" class="position-control__reset" data-reset-focal>Volver al centro</button>
                </div>
              </section>
              <fieldset>
                <legend>Texto alternativo</legend>
                <label class="field">ES <input data-alt="es" type="text" placeholder="Descripción en español" /></label>
                <label class="field">EN <input data-alt="en" type="text" placeholder="English description" /></label>
                <label class="field">PT <input data-alt="pt" type="text" placeholder="Descrição em português" /></label>
              </fieldset>
              <p class="hint">El texto alternativo describe la imagen para personas que usan lectores de pantalla.</p>
            </div>
          </details>

          <footer class="asset-card__actions">
            <p class="card-status" data-card-status role="status" aria-live="polite"></p>
            <button type="button" class="button button--secondary button--green-background" data-clear-resource hidden>Usar bloque verde</button>
            <button type="submit" class="button button--primary button--save">
              <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 10 3 3 7-7" /></svg>
              <span>Guardar borrador</span>
            </button>
          </footer>
        </form>
      </article>
    </template>

    <script>
      import '@/scripts/admin-dashboard';
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --canvas: #eeece5;
    --surface: #faf9f5;
    --surface-strong: #ffffff;
    --ink: #26302a;
    --muted: #697169;
    --soft: #879087;
    --olive: #536349;
    --olive-dark: #414f3b;
    --olive-light: #e4e9df;
    --line: #d7d8d1;
    --line-strong: #c6cac2;
    --danger: #9a3e2d;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--canvas);
  }

  * { box-sizing: border-box; }
  html { min-width: 320px; background: var(--canvas); }
  body { margin: 0; min-height: 100vh; overflow-x: hidden; background: var(--canvas); }
  main { min-height: 100vh; }
  [hidden] { display: none !important; }
  h1, h2, h3, h4, p { margin-top: 0; }
  button, input, select, textarea { font: inherit; }
  button, input, select, summary { -webkit-tap-highlight-color: transparent; }

  h1 { margin-bottom: .65rem; font: 400 clamp(2.15rem, 5vw, 3.9rem)/.98 Georgia, "Times New Roman", serif; letter-spacing: -.035em; }
  .eyebrow { margin-bottom: .7rem; color: #6b7a5e; font-size: .68rem; font-weight: 800; letter-spacing: .19em; text-transform: uppercase; }
  .field { display: grid; gap: .45rem; color: #536057; font-size: .8rem; font-weight: 720; }

  input, select {
    width: 100%; min-height: 46px; padding: .72rem .82rem; border: 1px solid var(--line-strong); border-radius: 11px;
    color: var(--ink); background: var(--surface-strong); box-shadow: 0 1px 1px rgba(38, 48, 42, .03), inset 0 1px 0 rgba(255, 255, 255, .65);
    transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
  }
  input::placeholder { color: #a0a69f; }
  input:hover, select:hover { border-color: #aeb5aa; }
  input:focus, select:focus { outline: none; border-color: var(--olive); box-shadow: 0 0 0 4px rgba(83, 99, 73, .13); }

  .button {
    display: inline-flex; align-items: center; justify-content: center; gap: .55rem; min-height: 44px; padding: .72rem 1.05rem;
    border: 1px solid transparent; border-radius: 12px; cursor: pointer; font-size: .84rem; font-weight: 760; line-height: 1;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease;
  }
  .button:hover:not(:disabled) { transform: translateY(-1px); }
  .button:active:not(:disabled) { transform: translateY(0); }
  .button:focus-visible, .section-tab:focus-visible, summary:focus-visible { outline: 3px solid rgba(83, 99, 73, .25); outline-offset: 3px; }
  .button:disabled { cursor: wait; opacity: .58; transform: none; }
  .button[aria-busy="true"] .button__icon { animation: button-pulse .9s ease-in-out infinite alternate; }
  .button__icon { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .button--primary { color: #fff; border-color: var(--olive-dark); background: linear-gradient(180deg, #5d6d52 0%, var(--olive) 100%); box-shadow: 0 7px 16px rgba(65, 79, 59, .18), inset 0 1px 0 rgba(255, 255, 255, .14); }
  .button--primary:hover:not(:disabled) { background: linear-gradient(180deg, #637459 0%, #4b5b43 100%); box-shadow: 0 9px 20px rgba(65, 79, 59, .23); }
  .button--secondary { color: #3f4d42; border-color: var(--line-strong); background: rgba(255, 255, 255, .78); box-shadow: 0 4px 12px rgba(38, 48, 42, .06); }
  .button--secondary:hover:not(:disabled) { border-color: #a8afa4; background: #fff; box-shadow: 0 6px 15px rgba(38, 48, 42, .09); }
  .button--quiet { color: #526057; border-color: transparent; background: transparent; }
  .button--quiet:hover:not(:disabled) { color: var(--ink); background: #e9e8e1; }
  .button--danger { color: #fff; border-color: #843323; background: linear-gradient(180deg, #a94735, #913726); box-shadow: 0 7px 16px rgba(125, 44, 29, .18); }
  .button--danger:hover:not(:disabled) { background: linear-gradient(180deg, #b24d39, #843020); box-shadow: 0 9px 20px rgba(125, 44, 29, .23); }
  .button--wide { width: 100%; min-height: 49px; margin-top: .2rem; }

  .panel { background: var(--surface); border: 1px solid rgba(198, 202, 194, .9); }
  .login {
    position: relative; isolation: isolate; min-height: 100svh; display: grid; place-items: center; overflow: hidden; padding: 1.5rem;
    background: radial-gradient(circle at 12% 14%, rgba(141, 157, 127, .2), transparent 30%), radial-gradient(circle at 88% 82%, rgba(105, 120, 92, .14), transparent 34%), var(--canvas);
  }
  .login::before, .login::after { position: absolute; z-index: -1; width: min(32vw, 430px); aspect-ratio: 1; border: 1px solid rgba(83, 99, 73, .11); border-radius: 50%; content: ""; }
  .login::before { top: -18%; right: -8%; }
  .login::after { bottom: -23%; left: -7%; }
  .login__panel { width: min(100%, 480px); padding: clamp(2rem, 6vw, 3.5rem); border-radius: 24px; box-shadow: 0 28px 80px rgba(38, 48, 42, .14), 0 2px 10px rgba(38, 48, 42, .04); }
  .login__mark, .toolbar__mark {
    display: grid; place-items: center; width: 50px; height: 50px; margin-bottom: 1.6rem; border: 1px solid rgba(83, 99, 73, .18); border-radius: 15px;
    color: #fff; background: var(--olive); box-shadow: 0 8px 20px rgba(65, 79, 59, .18); font: 700 .77rem/1 Georgia, serif; letter-spacing: .08em;
  }
  .login__lead { max-width: 35ch; margin-bottom: 0; color: var(--muted); font-size: .98rem; line-height: 1.65; }
  .login__form { display: grid; gap: 1rem; margin-top: 2rem; }

  .status { margin: 0; color: var(--danger); font-size: .8rem; line-height: 1.45; }
  .status[data-kind="success"], .card-status[data-kind="success"] { color: #397042; }
  .status--login { min-height: 1.2rem; margin-top: 1rem; text-align: center; }

  .dashboard { min-height: 100vh; }
  .toolbar {
    position: sticky; z-index: 20; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 2rem;
    padding: 1rem clamp(1rem, 3.6vw, 3.5rem); border-bottom: 1px solid rgba(199, 202, 195, .84); background: rgba(250, 249, 245, .92);
    box-shadow: 0 5px 22px rgba(38, 48, 42, .04); backdrop-filter: blur(16px);
  }
  .toolbar__identity { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .toolbar__mark { flex: none; width: 44px; height: 44px; margin: 0; border-radius: 13px; }
  .toolbar .eyebrow { margin-bottom: .25rem; }
  .toolbar h1 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.35rem); }
  .toolbar h1:focus { outline: none; }
  .toolbar__help { margin: .3rem 0 0; color: var(--muted); font-size: .8rem; line-height: 1.35; }
  .toolbar__actions { display: flex; flex: none; flex-wrap: wrap; justify-content: flex-end; gap: .55rem; }

  .dashboard__content { width: min(100%, 1500px); margin: 0 auto; padding: 1.25rem clamp(1rem, 3.6vw, 3.5rem) 4rem; }
  .dashboard__feedback { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2rem; margin-bottom: .9rem; }
  .status--dashboard { text-align: right; }
