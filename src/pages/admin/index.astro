  .experience-dialog::-webkit-scrollbar-track { background: #e5e5de; }
  .experience-dialog::-webkit-scrollbar-thumb { border: 2px solid #e5e5de; border-radius: 999px; background: linear-gradient(180deg, #78886d, var(--olive)); }
  .experience-editor { min-height: 100%; }
