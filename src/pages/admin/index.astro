  .experience-row__actions { display: flex; gap: .3rem; }
  .experience-row__actions button { display: grid; place-items: center; min-width: 34px; height: 34px; padding: 0 .55rem; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; color: #59655c; background: #fff; font-size: .7rem; font-weight: 760; }
  .experience-row__actions button:hover:not(:disabled) { border-color: var(--olive); color: var(--olive-dark); background: var(--olive-light); }
  .experience-row__actions button[data-action="delete"] { color: var(--danger); }
  .experience-row__actions button[data-action="delete"]:hover:not(:disabled) { border-color: #c68173; color: #7e2f20; background: #f8e8e4; }
  .experience-row__actions button:disabled { cursor: not-allowed; opacity: .35; }
  .experience-row__action-label { display: none; }
  .experience-manager__note { margin: 1rem 0 0; color: var(--muted); font-size: .7rem; line-height: 1.5; }

  .experience-dialog { width: min(1040px, calc(100vw - 28px)); max-height: calc(100svh - 28px); margin: auto; padding: 0; overflow: auto; border: 1px solid rgba(65, 79, 59, .24); border-radius: 22px; color: var(--ink); background: var(--surface); box-shadow: 0 32px 90px rgba(25, 31, 27, .3); scrollbar-color: var(--olive) #e5e5de; scrollbar-width: thin; }
  .experience-dialog::backdrop { background: rgba(23, 28, 25, .72); backdrop-filter: blur(7px); }
