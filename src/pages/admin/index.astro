  .preview-switch button { min-height: 30px; padding: .38rem .52rem; border: 1px solid transparent; border-radius: 8px; cursor: pointer; color: #687169; background: transparent; font-size: .65rem; font-weight: 760; }
  .preview-switch button[hidden] { display: none; }
  .preview-switch button:hover { color: var(--ink); background: #e7e9e3; }
  .preview-switch button[aria-pressed="true"] { color: #fff; border-color: var(--olive-dark); background: var(--olive); }
  .asset-card__form { display: grid; gap: 1rem; padding: 1.2rem; }
  .asset-card__heading { min-width: 0; }
  .asset-card__heading p { margin: 0 0 .35rem; color: var(--soft); font: 650 .62rem/1.4 ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
  .asset-card__heading h3 { margin: 0; font: 400 1.4rem/1.15 Georgia, serif; letter-spacing: -.015em; }

  .replacement { display: grid; gap: .85rem; padding: 1rem; border: 1px solid #dfe0da; border-radius: 14px; background: #f4f3ed; }
  .replacement__heading h4 { margin-bottom: .25rem; font-size: .81rem; }
  .replacement__heading p { margin: 0; color: var(--muted); font-size: .72rem; line-height: 1.45; }
  input[type="file"] { padding: .36rem; color: var(--muted); font-size: .72rem; }
  input[type="file"]::file-selector-button { min-height: 35px; margin-right: .65rem; padding: .5rem .75rem; border: 1px solid var(--line-strong); border-radius: 8px; cursor: pointer; color: #455147; background: #f0f1ec; font: inherit; font-weight: 760; }
  input[type="file"]::file-selector-button:hover { background: #e6e9e2; }
  .source-divider { display: flex; align-items: center; gap: .65rem; color: #8a918a; font-size: .64rem; font-weight: 760; text-transform: uppercase; letter-spacing: .08em; }
  .source-divider::before, .source-divider::after { height: 1px; flex: 1; background: #d9dbd4; content: ""; }
  .source-fields { display: grid; grid-template-columns: minmax(0, 1fr) 105px; gap: .65rem; }

  .asset-card__settings { overflow: hidden; border: 1px solid #dfe0da; border-radius: 13px; background: rgba(255, 255, 255, .48); }
  .asset-card__settings summary { display: flex; align-items: center; gap: .5rem; min-height: 46px; padding: .7rem .85rem; cursor: pointer; color: #4e5a51; font-size: .78rem; font-weight: 760; list-style: none; }
  .asset-card__settings summary::-webkit-details-marker { display: none; }
  .asset-card__settings summary::after { width: 8px; height: 8px; margin-left: auto; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; content: ""; transform: rotate(45deg) translateY(-2px); transition: transform .18s ease; }
  .asset-card__settings[open] summary::after { transform: rotate(225deg) translate(-2px, -2px); }
  .asset-card__settings summary small { color: var(--soft); font-size: .64rem; font-weight: 650; }
  .settings-body { display: grid; gap: .85rem; padding: 0 .85rem .9rem; border-top: 1px solid #e1e2dc; }
  .framing { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .8rem 1rem; margin-top: .85rem; padding-bottom: .9rem; border-bottom: 1px solid #e1e2dc; }
  .settings-heading { grid-column: 1 / -1; }
  .settings-heading h4 { margin: 0 0 .25rem; font-size: .76rem; }
  .settings-heading p { margin: 0; color: var(--muted); font-size: .69rem; line-height: 1.45; }
  .fit-options { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; align-self: start; }
  .fit-options button { display: grid; gap: .2rem; min-height: 66px; padding: .7rem; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; text-align: left; color: #4f5b52; background: #f8f8f4; }
  .fit-options button:hover { border-color: #aeb5aa; background: #fff; }
  .fit-options button[aria-pressed="true"] { border-color: var(--olive); color: var(--olive-dark); background: var(--olive-light); box-shadow: 0 0 0 2px rgba(83, 99, 73, .08); }
  .fit-options strong { font-size: .73rem; }
  .fit-options span { color: var(--muted); font-size: .62rem; line-height: 1.3; }
  .position-control { display: grid; align-content: start; gap: .55rem; padding: .72rem; border: 1px solid var(--line); border-radius: 10px; background: #f8f8f4; }
  .position-control__heading { display: flex; justify-content: space-between; gap: .5rem; color: #69736b; font-size: .65rem; font-weight: 760; }
  .position-control__heading output { color: var(--olive); font-weight: 800; }
  .position-control__help { margin: 0; color: var(--muted); font-size: .66rem; line-height: 1.45; }
  .position-control__reset { justify-self: start; min-height: 31px; padding: .4rem .62rem; border: 1px solid var(--line-strong); border-radius: 8px; cursor: pointer; color: #4f5b52; background: #fff; font-size: .65rem; font-weight: 760; }
  .position-control__reset:hover:not(:disabled) { border-color: var(--olive); color: var(--olive-dark); background: var(--olive-light); }
  .position-control__reset:disabled { cursor: not-allowed; opacity: .48; }
  fieldset { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; margin: .8rem 0 0; padding: 0; border: 0; }
  legend { margin-bottom: .55rem; padding: 0; color: #69736b; font-size: .69rem; font-weight: 760; }
  .hint { margin: -.25rem 0 0; color: #7c847d; font-size: .67rem; line-height: 1.45; }

  .asset-card__actions { display: flex; align-items: center; justify-content: flex-end; gap: .8rem; padding-top: .05rem; }
  .card-status { flex: 1; min-width: 0; margin: 0; color: var(--danger); font-size: .72rem; line-height: 1.35; }
  .button--save { flex: none; }
  .button--green-background { flex: none; }

  textarea {
    width: 100%; min-height: 92px; resize: vertical; padding: .78rem .82rem; border: 1px solid var(--line-strong); border-radius: 11px;
    color: var(--ink); background: var(--surface-strong); font: inherit; line-height: 1.5; transition: border-color .18s ease, box-shadow .18s ease;
  }
  textarea:hover { border-color: #aeb5aa; }
  textarea:focus { outline: none; border-color: var(--olive); box-shadow: 0 0 0 4px rgba(83, 99, 73, .13); }
  .field small { color: var(--soft); font-size: .67rem; font-weight: 550; line-height: 1.4; }

  .experience-manager { margin: 0 0 1.2rem; padding: clamp(1rem, 2.6vw, 1.6rem); border: 1px solid var(--line); border-radius: 20px; background: var(--surface); box-shadow: 0 10px 30px rgba(38, 48, 42, .055); }
  .experience-manager__head { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; }
  .experience-manager__head .eyebrow { margin-bottom: .3rem; }
  .experience-manager__head h3 { margin: 0 0 .4rem; font: 400 clamp(1.45rem, 2.7vw, 2rem)/1.05 Georgia, serif; }
  .experience-manager__head p:last-child { max-width: 66ch; margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.5; }
  #experience-manager-status { min-height: 1.1rem; margin-bottom: .65rem; }
  .experience-list { display: grid; gap: .55rem; margin: 0; padding: 0; list-style: none; counter-reset: experience; }
  .experience-row { display: grid; grid-template-columns: 38px 42px minmax(0, 1fr) auto auto; align-items: center; gap: .7rem; min-height: 70px; padding: .65rem .75rem; border: 1px solid #dde0d9; border-radius: 13px; background: #f8f7f2; transition: border-color .16s ease, background .16s ease, box-shadow .16s ease, opacity .16s ease; }
  .experience-row:hover { border-color: #bcc3b8; background: #fff; box-shadow: 0 7px 18px rgba(38, 48, 42, .065); }
  .experience-row[data-dragging="true"] { opacity: .48; border-color: var(--olive); }
  .experience-row[data-drag-over="true"] { border-color: var(--olive); background: var(--olive-light); box-shadow: 0 0 0 3px rgba(83, 99, 73, .1); }
  .experience-row[data-status="archived"] { opacity: .62; }
  .experience-row__handle { display: grid; place-items: center; width: 36px; height: 42px; padding: 0; border: 0; border-radius: 8px; cursor: grab; color: #788179; background: transparent; }
  .experience-row__handle:hover { color: var(--olive-dark); background: var(--olive-light); }
  .experience-row__handle:active { cursor: grabbing; }
  .experience-row__handle svg { width: 18px; height: 18px; fill: currentColor; }
  .experience-row__order { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 50%; color: var(--olive-dark); background: #fff; font: 750 .76rem/1 ui-monospace, monospace; }
  .experience-row__copy { min-width: 0; }
  .experience-row__copy strong { display: block; overflow: hidden; color: var(--ink); font: 400 1rem/1.25 Georgia, serif; text-overflow: ellipsis; white-space: nowrap; }
  .experience-row__copy small { display: block; overflow: hidden; margin-top: .25rem; color: var(--soft); font: 600 .62rem/1.3 ui-monospace, monospace; text-overflow: ellipsis; white-space: nowrap; }
  .experience-row__badges { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; }
  .experience-row__badge { padding: .3rem .5rem; border-radius: 999px; color: #47604c; background: #e7efe7; font-size: .61rem; font-weight: 780; white-space: nowrap; }
  .experience-row__badge[data-kind="draft"] { color: #76541c; background: #f7e9ca; }
