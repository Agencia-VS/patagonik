---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/content.config';
import { useTranslations } from '@/i18n';
import { experiencePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'experiences'>;
}
const { locale, entry } = Astro.props;
const c = entry.data.content[locale];
const t = useTranslations(locale);
---

<article class="pk-card">
  {/*
    Hueco de imagen. Cuando lleguen las fotos, aquí entra <Image> de
    astro:assets y genera srcset/webp solo; hasta entonces se marca el sitio
    para que el layout ya sea el definitivo.
  */}
  <div class="pk-card__media" data-image={entry.data.image} aria-hidden="true"></div>

  <div class="pk-card__body">
    {c.cardCategory && <p class="pk-card__cat">{c.cardCategory}</p>}
    <h3><a href={experiencePath(entry.data.slug, locale)}>{c.cardTitle}</a></h3>
    <p class="pk-card__summary">{c.cardSummary}</p>
    <p class="pk-card__detail">{c.cardDetail}</p>
    <span class="pk-card__more">{t('exp.detail')} →</span>
  </div>
</article>

<style>
  .pk-card {
    display: flex;
    flex-direction: column;
    background: rgba(36, 43, 39, 0.96);
    color: var(--pk-cream);
    scroll-snap-align: start;
    flex: 0 0 clamp(285px, 25vw, 340px);
  }
  .pk-card__media {
    aspect-ratio: 4 / 3;
    background: linear-gradient(165deg, #3d4e5c, #7e8c7a);
  }
  .pk-card__body {
    padding: 14px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pk-card__cat {
    margin: 0;
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .pk-card h3 {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    margin: 0;
  }
  .pk-card h3 a {
    text-decoration: none;
  }
  .pk-card h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .pk-card__summary {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0.82;
  }
  .pk-card__detail {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.66;
  }
  .pk-card__more {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.5;
  }
</style>
