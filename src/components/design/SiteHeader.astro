---
import type { Locale } from '@/content.config';
import { useTranslations } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header data-hdr="" style="position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px clamp(18px, 5vw, 56px); color: #F5F2EC; transition: color .6s ease, background-color .6s ease;">
    <div style="display: flex; align-items: center; gap: clamp(8px, 2.5vw, 18px);">
      <button type="button" data-menu-toggle="" aria-expanded="false" aria-label="Menú" style="appearance: none; background: none; border: 0; display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; padding: 0; color: inherit; cursor: pointer;">
        <span data-bar1="" aria-hidden="true" style="display: block; width: 22px; height: 1px; background: currentColor; transition: transform .5s cubic-bezier(.19,1,.22,1), opacity .3s ease;"></span>
        <span data-bar2="" aria-hidden="true" style="display: block; width: 22px; height: 1px; background: currentColor; transition: transform .5s cubic-bezier(.19,1,.22,1), opacity .3s ease;"></span>
      </button>
      <a href="/" data-route-link="" data-route-path="/" data-hdr-logo="" style="font-family: Georgia, 'Times New Roman', serif; font-size: clamp(16px, 3.6vw, 20px); line-height: 1; letter-spacing: .17em; color: inherit; opacity: 0; pointer-events: none;">PatagoniK</a>
    </div>

    <div style="margin-left: auto; display: flex; align-items: center; gap: clamp(4px, 2vw, 14px);">
      <div style="position: relative;">
        <button type="button" data-langtoggle="" aria-haspopup="listbox" aria-expanded="false" aria-label="Idioma" style="appearance: none; background: none; border: 0; display: flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 8px; font: inherit; font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: inherit; cursor: pointer;">
          <span data-langcurrent="">ES</span>
          <svg data-langchev="" width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true" style="transition: transform .5s cubic-bezier(.19,1,.22,1); opacity: .7;"><path d="M1.5 3.5 5 7l3.5-3.5"></path></svg>
        </button>
        <div data-langmenu="" role="listbox" aria-label="Idioma" style="position: absolute; top: calc(100% + 8px); right: 0; min-width: 152px; padding: 6px; background: #F5F2EC; color: #2B2B2B; border: 1px solid rgba(43,43,43,.1); box-shadow: 0 20px 46px rgba(43,43,43,.18); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .35s ease, transform .35s cubic-bezier(.19,1,.22,1), visibility .35s;">
          <button type="button" data-lang="es" role="option" aria-selected="true" style="appearance: none; background: none; border: 0; display: block; width: 100%; text-align: left; padding: 11px 12px; font: inherit; font-family: Georgia, 'Times New Roman', serif; font-size: 18px; color: #2B2B2B; cursor: pointer;">Español</button>
          <button type="button" data-lang="en" role="option" aria-selected="false" style="appearance: none; background: none; border: 0; display: block; width: 100%; text-align: left; padding: 11px 12px; font: inherit; font-family: Georgia, 'Times New Roman', serif; font-size: 18px; color: #2B2B2B; cursor: pointer;">English</button>
          <button type="button" data-lang="pt" role="option" aria-selected="false" style="appearance: none; background: none; border: 0; display: block; width: 100%; text-align: left; padding: 11px 12px; font: inherit; font-family: Georgia, 'Times New Roman', serif; font-size: 18px; color: #2B2B2B; cursor: pointer;">Português</button>
        </div>
      </div>

      <a data-wa="" data-btn="" data-hdr-cta="" href="https://wa.me/56931712780" target="_blank" rel="noopener" style="position: relative; display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 17px; color: #4F5D45; font-size: clamp(9px, 2.3vw, 11px); font-weight: 600; letter-spacing: .13em; text-transform: uppercase; white-space: nowrap;">
        <span data-btn-bg="" aria-hidden="true" style="position: absolute; inset: 0; border-radius: 999px; background: #EDE7DA; transition: transform .9s cubic-bezier(.19,1,.22,1); will-change: transform;"></span>
        <span data-t="cta" style="position: relative;">{t('cta')}</span>
        <svg data-btn-arrow="" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="#9C998F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="position: relative; transform: rotate(-45deg); transition: transform 1s cubic-bezier(.19,1,.22,1), stroke 1s ease;"><path d="M1.2 6h9.6M7.2 2.4 10.8 6l-3.6 3.6"></path></svg>
      </a>
    </div>
  </header>
<nav data-menu="" aria-label="Secciones" style="position:fixed; z-index:59; top:68px; left:clamp(14px,3vw,34px); width:min(390px,calc(100vw - 28px)); max-height:calc(100svh - 88px); overflow:auto; display:flex; flex-direction:column; padding:18px 20px 16px; border:1px solid rgba(245,242,236,.11); border-radius:18px; background:rgba(36,49,41,.97); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); box-shadow:0 18px 55px rgba(18,25,21,.28); color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; visibility:hidden; transform:translateY(-10px) scale(.985); transform-origin:top left; transition:opacity .28s ease, transform .36s cubic-bezier(.19,1,.22,1), visibility .28s;">
    <div style="display:grid; grid-template-columns:1fr; gap:0;">
      <a data-menu-link="" data-route-link="" data-t="menu.home" href="/" style="font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.home')}</a>
      <a data-menu-link="" data-t="menu.tours" href="#experiencias" style="font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.tours')}</a>
      <a data-menu-link="" data-t="menu.quote" href="#cotiza" style="font-family:Georgia,'Times New Roman',serif; font-weight:400; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#D6BE9C; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.quote')}</a>
      <a data-menu-link="" data-route-link="" data-t="menu.about" href="/tabs/quienes-somos" style="font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.about')}</a>
      <a data-menu-link="" data-route-link="" data-t="menu.faq" href="/tabs/faq" style="font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.faq')}</a>
      <a data-menu-link="" data-t="menu.contact" href="#contacto" style="font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.02rem,2.2vw,1.28rem); line-height:1.2; color:#F5F2EC; border-bottom:1px solid rgba(245,242,236,.07); opacity:0; transform:translateY(22px); transition:opacity .7s ease,transform .8s cubic-bezier(.19,1,.22,1);">{t('menu.contact')}</a>
    </div>

    <div style="margin-top:14px; padding-top:12px; display:flex; flex-wrap:wrap; gap:14px; border-top:1px solid rgba(245,242,236,.10); font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:rgba(245,242,236,.58);">
      <button type="button" data-lang="es" style="appearance:none;background:none;border:0;padding:0;font:inherit;letter-spacing:inherit;color:inherit;cursor:pointer;">Español</button>
      <button type="button" data-lang="en" style="appearance:none;background:none;border:0;padding:0;font:inherit;letter-spacing:inherit;color:inherit;cursor:pointer;">English</button>
      <button type="button" data-lang="pt" style="appearance:none;background:none;border:0;padding:0;font:inherit;letter-spacing:inherit;color:inherit;cursor:pointer;">Português</button>
    </div>
  </nav>
