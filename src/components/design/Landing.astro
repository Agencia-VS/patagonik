    <!--
      C2 — Selector de experiencia y cotización, en una sola sección.

      Antes eran dos: #selector (fondo claro, "¿Qué Patagonia quieres vivir?") y
      #cotiza (foto de cascada, "Cuéntanos lo esencial"), con dos encabezados,
      dos apariciones y dos etiquetas de pantalla. Ahora hay un solo <section>
      con un encabezado y un recorrido continuo: elegir arriba, cotizar abajo.

      #selector sobrevive como <div> envolviendo el quiz: hay una quincena de
      reglas CSS que lo referencian por id y así siguen aplicando sin tener que
      reescribirlas una por una. El bloque pk-quote-merge-v48 neutraliza sólo lo
      que ya no corresponde (padding y fondo de sección).
    -->
    <section id="cotiza" data-nav="dark" data-screen-label="04 Encuentra tu experiencia y cotiza" style="padding:clamp(66px,12vw,124px) clamp(22px,6vw,96px); background:#232725; color:#F5F2EC; position:relative; overflow:hidden; isolation:isolate;">
      <div aria-hidden="true" id="pk-quote-overlay" style="position:absolute; inset:0; z-index:0; background:linear-gradient(180deg, rgba(35,39,37,.34) 0%, rgba(35,39,37,.22) 42%, rgba(35,39,37,.38) 100%);"></div>

      <div style="max-width:1180px; margin:0 auto;">
        <div data-reveal="" style="max-width:760px; opacity:0; transform:translateY(26px); transition:opacity .9s ease, transform .9s ease;">
          <p data-t="quiz.kicker" style="margin:0 0 12px; font-size:10px; letter-spacing:.28em; text-transform:uppercase; color:#6B7A5E;">{t('quiz.kicker')}</p>
          <h2 data-t="quiz.title" style="margin:0; font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(34px,6vw,64px); line-height:1.02; color:#2B2B2B;">{t('quiz.title')}</h2>
          <p data-t="quiz.intro" style="margin:18px 0 0; max-width:58ch; font-size:15px; line-height:1.72; font-weight:300; color:rgba(43,43,43,.68);">{t('quiz.intro')}</p>
        </div>

        <div id="selector">
        <div style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,2vw,24px); margin-top:clamp(34px,6vw,56px);" id="pk-quiz-grid">
          <div data-reveal="" style="padding:clamp(22px,3vw,30px); border:1px solid rgba(43,43,43,.10); background:#FFFDF9; opacity:0; transform:translateY(24px); transition:opacity .9s ease, transform .9s ease;">
            <span style="display:block; margin-bottom:10px; font-size:10px; letter-spacing:.2em; color:#6B7A5E;">01</span>
            <h3 data-t="quiz.q1" style="margin:0 0 18px; font-family:Georgia,'Times New Roman',serif; font-weight:400; font-size:22px;">{t('quiz.q1')}</h3>
            <div style="display:flex; flex-wrap:wrap; gap:9px;">
              <button type="button" data-quiz-option="" data-quiz-group="interest" data-quiz-value="trekking" data-t="quiz.trekking" style="padding:10px 13px; border:1px solid rgba(43,43,43,.14); border-radius:999px; background:transparent; color:#2B2B2B; cursor:pointer;">{t('quiz.trekking')}</button>
              <button type="button" data-quiz-option="" data-quiz-group="interest" data-quiz-value="paisajes" data-t="quiz.landscapes" style="padding:10px 13px; border:1px solid rgba(43,43,43,.14); border-radius:999px; background:transparent; color:#2B2B2B; cursor:pointer;">{t('quiz.landscapes')}</button>
              <button type="button" data-quiz-option="" data-quiz-group="interest" data-quiz-value="fauna" data-t="quiz.wildlife" style="padding:10px 13px; border:1px solid rgba(43,43,43,.14); border-radius:999px; background:transparent; color:#2B2B2B; cursor:pointer;">{t('quiz.wildlife')}</button>
