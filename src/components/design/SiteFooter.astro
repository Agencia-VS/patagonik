---
import type { Locale } from '@/content.config';
import { useTranslations } from '@/i18n';

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
}
const { locale, alternates } = Astro.props;
const t = useTranslations(locale);

const LANGUAGES: { code: Locale; label: string }[] = [
  { code: 'es', label: 'Español' },
  { code: 'en', label: 'English' },
  { code: 'pt', label: 'Português' },
];
---

<footer id="contacto" data-nav="dark" style="background: #232725; color: rgba(245,242,236,.72); padding: clamp(52px, 12vw, 90px) clamp(22px, 6vw, 96px);">
    <div style="max-width: 1180px; margin: 0 auto; display: grid; gap: clamp(32px, 7vw, 56px); grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));">
      <div>
        <span style="font-family: Georgia, 'Times New Roman', serif; font-size: 26px; line-height: 1; letter-spacing: .17em; color: #F5F2EC;">PatagoniK</span>
        <p data-t="footer.tag" style="margin: 12px 0 0; font-size: 13px; line-height: 1.7; font-weight: 300; max-width: 26ch;">{t('footer.tag')}</p>
      </div>
      <div>
        <p data-t="footer.contact" style="margin: 0 0 14px; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: rgba(245,242,236,.45);">{t('footer.contact')}</p>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 300;">
          <a href="https://wa.me/56931712780?text=Hola%2C%20quiero%20cotizar%20una%20experiencia%20con%20PatagoniK" target="_blank" rel="noopener" style="color: rgba(245,242,236,.86);">WhatsApp · +56 9 3171 2780</a>
          <a href="https://wa.me/56974357864?text=Hola%2C%20quiero%20cotizar%20una%20experiencia%20con%20PatagoniK" target="_blank" rel="noopener" style="color: rgba(245,242,236,.86);">WhatsApp · +56 9 7435 7864</a>
          <a href="mailto:patagoniknatales@gmail.com" style="color: rgba(245,242,236,.86);">patagoniknatales@gmail.com</a>
          <span>Puerto Natales, Chile</span>
        </div>
      </div>
      <div>
        <p data-t="footer.social" style="margin: 0 0 14px; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: rgba(245,242,236,.45);">{t('footer.social')}</p>
        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 14px; font-weight: 300;">
          <a href="https://www.instagram.com/patagonik.natales/" target="_blank" rel="noopener" aria-label="Instagram PatagoniK" title="@Patagonik.natales" style="display:inline-flex; align-items:center; gap:10px; color:rgba(245,242,236,.9);">
            <span style="display:inline-flex; align-items:center; justify-content:center; width:38px; height:38px; flex:0 0 38px; border:1px solid rgba(245,242,236,.22); border-radius:999px;">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
            </span>
            <span style="font-size:14px; font-weight:300; letter-spacing:.01em;">@Patagonik.natales</span>
          </a>
        </div>
      </div>
      <div>
        <p data-t="footer.lang" style="margin: 0 0 14px; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: rgba(245,242,236,.45);">{t('footer.lang')}</p>
        <div style="display: flex; gap: 14px; font-size: 14px; font-weight: 300;">
          {LANGUAGES.map((language) => (
            <a href={alternates[language.code]} data-lang={language.code} aria-current={language.code === locale ? 'page' : undefined} style="color: rgba(245,242,236,.86); text-decoration: none; cursor: pointer;">{language.label}</a>
          ))}
        </div>
      </div>
    </div>
    <p style="max-width: 1180px; margin: clamp(40px, 9vw, 64px) auto 0; font-size: 11px; letter-spacing: .1em; color: rgba(245,242,236,.35);">© 2026 PatagoniK · Puerto Natales</p>
  </footer>
