---
import type { Locale } from '@/content.config';
import { useTranslations } from '@/i18n';
import CloudinaryImage from '@/components/media/CloudinaryImage.astro';
import type { LandingAssetMap } from '@/lib/media/types';

interface Props { locale: Locale; assets: LandingAssetMap }
const { locale, assets } = Astro.props;
const t = useTranslations(locale);
const asset = (slotKey: string) => {
  const value = assets[slotKey];
  if (!value) throw new Error(`Asset requerido no encontrado: ${slotKey}`);
  return value;
};
---

<section id="esencia" data-esc="" data-nav="light" data-screen-label="02 Nuestra esencia" style="position: relative; overflow: hidden; background: #F5F2EC; padding: clamp(68px, 11vw, 124px) 0 clamp(96px, 14vw, 168px);">
      <div data-esc-band="" aria-hidden="true" style="position: absolute; z-index: 0; left: 0; right: 0; top: 40%; bottom: 12%; overflow: hidden;">
        <div data-esc-green-fill="" data-accent-bg="" style="position: absolute; inset: 0; background: #6B7A5E; transform: translateY(100%); will-change: transform;"></div>
      </div>

      <div data-esc-grid="" style="position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding: 0 clamp(22px, 6vw, 96px); display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(12px, 2vw, 28px); row-gap: clamp(30px, 5vw, 62px);">


        <div data-esc-text="" style="grid-column: 5 / 10; grid-row: 1; align-self: end; max-width: 460px;">
          <h2 data-reveal="" style="margin: 0; overflow: hidden; padding-bottom: .12em;">
            <span data-mask-inner="" style="display:block; font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(1.9rem,4.4vw,3rem); line-height:1.04; letter-spacing:-.005em; color:#F5F2EC; transform:translateY(110%); transition:transform 1.2s cubic-bezier(.19,1,.22,1);">
              <span data-t="esc.title.main" style="display:block;">{t('esc.title.main')}</span>
              <span data-t="esc.title.sub" style="display:block; margin-top:.12em;">{t('esc.title.sub')}</span>
            </span>
          </h2>
          <p data-esc-intro="" data-reveal="" data-t="hero.sub" style="margin: clamp(16px, 2.2vw, 24px) 0 0; font-size: clamp(14px, 3.7vw, 16px); line-height: 1.75; font-weight: 300; color: rgba(245,242,236,.82); text-wrap: pretty; opacity: 0; transform: translateY(22px); transition: opacity 1s .1s cubic-bezier(.22,.61,.36,1), transform 1s .1s cubic-bezier(.22,.61,.36,1);">{t('hero.sub')}</p>
          <a data-esc-btn="" data-reveal="" href="#experiencias" style="display: inline-flex; align-items: center; gap: 11px; margin-top: clamp(26px, 3.4vw, 38px); min-height: 52px; padding: 0 10px 0 26px; border-radius: 999px; background: #F5F2EC; color: #2B2B2B; font-size: 11px; letter-spacing: .15em; text-transform: uppercase; white-space: nowrap; opacity: 0; transform: translateY(20px); transition: opacity .9s .2s cubic-bezier(.22,.61,.36,1), transform .9s .2s cubic-bezier(.22,.61,.36,1), background-color .5s ease, color .5s ease;" style-hover="background: #2B2B2B; color: #F5F2EC;">
            <span data-t="esc.cta">{t('esc.cta')}</span>
            <span aria-hidden="true" style="display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 999px; border: 1px solid rgba(43,43,43,.22);">
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3.2 8.8 8.8 3.2M4.4 3.2h4.4v4.4"></path></svg>
            </span>
          </a>
        </div>

        <div data-esc-stack="" style="grid-column: 2 / 9; grid-row: 2; position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: linear-gradient(165deg, #3D4E5C 0%, #7E8C7A 100%);">
          <div data-par="0.12" style="position: absolute; inset: -13% 0;">
            <image-slot id="pt-esc-main" shape="rect" fit="cover"><CloudinaryImage asset={asset('about.essence')} locale={locale} preset="essence" decorative /></image-slot>
          </div>
        </div>

        <p data-esc-para="" data-reveal="" data-t="prob.body" style="grid-column: 9 / -1; grid-row: 2; align-self: center; margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.9rem, 4.4vw, 3rem); line-height: 1.04; letter-spacing: -.005em; font-weight: 300; color: rgba(245,242,236,.92); text-wrap: balance; opacity: 0; transform: translateY(26px); transition: opacity 1s .08s cubic-bezier(.22,.61,.36,1), transform 1s .08s cubic-bezier(.22,.61,.36,1);">{t('prob.body')}</p>
      </div>
    </section>

    <section id="resenas" data-nav="light" data-screen-label="08 Prueba social" style="padding: clamp(24px, 5vw, 52px) clamp(22px, 6vw, 96px) clamp(50px, 10vw, 96px); background: #F5F2EC;">
      <div style="max-width: 1180px; margin: 0 auto;">
        <div data-reveal="" style="display: flex; flex-wrap: wrap; align-items: baseline; gap: clamp(14px, 4vw, 28px); opacity: 0; transform: translateY(30px); transition: opacity 1s cubic-bezier(.22,.61,.36,1), transform 1s cubic-bezier(.22,.61,.36,1);">
          <span style="display: inline-block; overflow: hidden; vertical-align: bottom; padding: .04em 0 .12em;"><span data-mask-inner="" data-accent-text="" data-t="social.figure" style="display: block; font-family: Georgia, 'Times New Roman', serif; font-weight: 300; font-size: clamp(4rem, 22vw, 9rem); line-height: 1.02; letter-spacing: -.03em; color: #6B7A5E; transform: translateY(108%); transition: transform 1.3s cubic-bezier(.19,1,.22,1);">{t('social.figure')}</span></span>
          <span data-t="social.figureLabel" style="font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: rgba(43,43,43,.6); max-width: 12ch; line-height: 1.7;">{t('social.figureLabel')}</span>
        </div>

        <div data-reveal="" style="display: flex; flex-wrap: wrap; gap: 10px 18px; margin: clamp(18px, 3vw, 30px) 0 clamp(26px, 4vw, 38px); font-size: 11px; letter-spacing: .26em; color: rgba(43,43,43,.45); font-weight: 500; opacity: 0; transform: translateY(24px); transition: opacity 1s .1s ease, transform 1s .1s ease;">
          <span>CHILE</span><span>BRASIL</span><span>EE.UU.</span><span>ALEMANIA</span><span>FRANCIA</span><span>ARGENTINA</span>
        </div>

        <div data-reveal="" style="margin:0 0 clamp(20px,3vw,30px); opacity:0; transform:translateY(20px); transition:opacity .9s ease, transform .9s ease;">
          <p style="margin:0 0 8px; font-size:10px; letter-spacing:.26em; text-transform:uppercase; color:#6B7A5E;">Experiencias reales</p>
          <h3 style="margin:0; font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(28px,5vw,44px); line-height:1.08; color:#2B2B2B;">Lo que dicen quienes viajaron con nosotros.</h3>
        </div>
        <div id="pk-review-grid" style="display:grid; gap:clamp(12px,1.5vw,18px); grid-template-columns:repeat(4,minmax(0,1fr));">

          <figure data-reveal="" style="margin:0; min-height:350px; display:flex; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); opacity:0; transform:translateY(30px); transition:opacity 1s 0.05s cubic-bezier(.22,.61,.36,1), transform 1s 0.05s cubic-bezier(.22,.61,.36,1), border-color .6s ease, background-color .6s ease;" style-hover="border-color:rgba(107,122,94,.4); background:#FFFFFF;">
            <div style="padding:clamp(26px,4vw,38px); display:flex; flex:1; flex-direction:column;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px;">
                <span style="font-size:9px; letter-spacing:.22em; text-transform:uppercase; color:#6B7A5E;">Reseña de pasajero</span>
                <span aria-hidden="true" style="font-family:Georgia,'Times New Roman',serif; font-size:42px; line-height:.7; color:rgba(107,122,94,.32);">“</span>
              </div>
              <blockquote style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(15px,1.35vw,18px); line-height:1.48; font-weight:300; font-style:italic; color:#2B2B2B;">“My partner and I had an incredible experience hiking the Torres del Paine Base Trek. What started as a guided hike felt more like an adventure with friends. I highly recommend them to anyone looking for an authentic, enjoyable and unforgettable hiking experience.”</blockquote>
              <figcaption style="margin-top:auto; padding-top:18px; border-top:1px solid rgba(43,43,43,.08);">
                <strong style="display:block; font-size:12px; letter-spacing:.12em; text-transform:uppercase; font-weight:600; color:#2B2B2B;">Crystal & Will</strong>
                <span style="display:block; margin-top:7px; font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:rgba(43,43,43,.46);">Australia · Base Torres</span>
              </figcaption>
            </div>
          </figure>
          <figure data-reveal="" style="margin:0; min-height:350px; display:flex; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); opacity:0; transform:translateY(30px); transition:opacity 1s 0.13s cubic-bezier(.22,.61,.36,1), transform 1s 0.13s cubic-bezier(.22,.61,.36,1), border-color .6s ease, background-color .6s ease;" style-hover="border-color:rgba(107,122,94,.4); background:#FFFFFF;">
            <div style="padding:clamp(26px,4vw,38px); display:flex; flex:1; flex-direction:column;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px;">
                <span style="font-size:9px; letter-spacing:.22em; text-transform:uppercase; color:#6B7A5E;">Reseña de pasajero</span>
                <span aria-hidden="true" style="font-family:Georgia,'Times New Roman',serif; font-size:42px; line-height:.7; color:rgba(107,122,94,.32);">“</span>
              </div>
              <blockquote style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(15px,1.35vw,18px); line-height:1.48; font-weight:300; font-style:italic; color:#2B2B2B;">“Gracias por todo!! Lo pasamos súper y tenemos las mejores fotos para el recuerdo. Sí, y obvio que te vamos a recomendar.”</blockquote>
              <figcaption style="margin-top:auto; padding-top:18px; border-top:1px solid rgba(43,43,43,.08);">
                <strong style="display:block; font-size:12px; letter-spacing:.12em; text-transform:uppercase; font-weight:600; color:#2B2B2B;">Trini Carvallo</strong>
                <span style="display:block; margin-top:7px; font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:rgba(43,43,43,.46);">Reseña de pasajera</span>
              </figcaption>
            </div>
          </figure>
          <figure data-reveal="" style="margin:0; min-height:350px; display:flex; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); opacity:0; transform:translateY(30px); transition:opacity 1s 0.21s cubic-bezier(.22,.61,.36,1), transform 1s 0.21s cubic-bezier(.22,.61,.36,1), border-color .6s ease, background-color .6s ease;" style-hover="border-color:rgba(107,122,94,.4); background:#FFFFFF;">
            <div style="padding:clamp(26px,4vw,38px); display:flex; flex:1; flex-direction:column;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px;">
                <span style="font-size:9px; letter-spacing:.22em; text-transform:uppercase; color:#6B7A5E;">Reseña de pasajero</span>
                <span aria-hidden="true" style="font-family:Georgia,'Times New Roman',serif; font-size:42px; line-height:.7; color:rgba(107,122,94,.32);">“</span>
              </div>
              <blockquote style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(15px,1.35vw,18px); line-height:1.48; font-weight:300; font-style:italic; color:#2B2B2B;">“Fue perfecto. El día estuvo precioso, con muy buen clima, y Armando fue muy paciente con nuestra lentitud y además excelente compañía. ¡Muchas gracias por las zapatillas para mi hermano y por los snacks! Todo estuvo muy bien.”</blockquote>
              <figcaption style="margin-top:auto; padding-top:18px; border-top:1px solid rgba(43,43,43,.08);">
                <strong style="display:block; font-size:12px; letter-spacing:.12em; text-transform:uppercase; font-weight:600; color:#2B2B2B;">Fernanda</strong>
                <span style="display:block; margin-top:7px; font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:rgba(43,43,43,.46);">Reseña de pasajera</span>
              </figcaption>
            </div>
          </figure>
          <figure data-reveal="" style="margin:0; min-height:350px; display:flex; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); opacity:0; transform:translateY(30px); transition:opacity 1s 0.29s cubic-bezier(.22,.61,.36,1), transform 1s 0.29s cubic-bezier(.22,.61,.36,1), border-color .6s ease, background-color .6s ease;" style-hover="border-color:rgba(107,122,94,.4); background:#FFFFFF;">
            <div style="padding:clamp(26px,4vw,38px); display:flex; flex:1; flex-direction:column;">
              <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px;">
                <span style="font-size:9px; letter-spacing:.22em; text-transform:uppercase; color:#6B7A5E;">Reseña de pasajero</span>
                <span aria-hidden="true" style="font-family:Georgia,'Times New Roman',serif; font-size:42px; line-height:.7; color:rgba(107,122,94,.32);">“</span>
              </div>
              <blockquote style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(15px,1.35vw,18px); line-height:1.48; font-weight:300; font-style:italic; color:#2B2B2B;">“Súper nos gustó!!! Mil gracias por todo, por tu paciencia y tu entusiasmo. Admiro mucho la energía que le pones a tu trabajo; nos llevamos en el corazón esta magnífica experiencia. Definitivamente regresaremos.”</blockquote>
              <figcaption style="margin-top:auto; padding-top:18px; border-top:1px solid rgba(43,43,43,.08);">
                <strong style="display:block; font-size:12px; letter-spacing:.12em; text-transform:uppercase; font-weight:600; color:#2B2B2B;">Eri</strong>
                <span style="display:block; margin-top:7px; font-size:10px; letter-spacing:.15em; text-transform:uppercase; color:rgba(43,43,43,.46);">Reseña de pasajera</span>
              </figcaption>
            </div>
          </figure>
        </div>
      </div>
  
        <div id="google-reviews" data-google-reviews="" data-place-id="" data-google-maps-url="" style="margin-top:clamp(28px,5vw,48px); padding-top:clamp(28px,5vw,46px); border-top:1px solid rgba(43,43,43,.10);">
          <div style="display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:clamp(18px,3vw,28px);">
            <div>
              <p style="margin:0 0 8px; font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:#6B7A5E;">Reseñas verificadas</p>
              <h3 style="margin:0; font-family:Georgia,'Times New Roman',serif; font-weight:300; font-size:clamp(26px,4vw,40px); line-height:1.08; color:#2B2B2B;">Opiniones en Google</h3>
            </div>
            <div style="display:flex; align-items:center; gap:10px; min-height:40px; padding:0 14px; border:1px solid rgba(43,43,43,.10); border-radius:999px; background:#FFFDF9;">
              <span aria-hidden="true" style="font-weight:700; font-size:18px; line-height:1;">G</span>
              <span data-google-rating="" style="font-size:12px; letter-spacing:.08em; color:#2B2B2B;">★ — / 5</span>
            </div>
          </div>

          <div data-google-review-grid="" style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(12px,2vw,20px);">
            <article data-google-review-placeholder="" style="min-height:180px; padding:22px; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                  <span style="width:34px; height:34px; border-radius:999px; background:rgba(107,122,94,.12);"></span>
                  <div style="flex:1;">
                    <div style="width:46%; height:8px; background:rgba(43,43,43,.10); margin-bottom:7px;"></div>
                    <div style="width:30%; height:6px; background:rgba(43,43,43,.07);"></div>
                  </div>
                </div>
                <div style="letter-spacing:.12em; font-size:12px; color:#6B7A5E; margin-bottom:12px;">★★★★★</div>
                <div style="width:100%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:92%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:68%; height:7px; background:rgba(43,43,43,.08);"></div>
              </div>
            </article>
            <article data-google-review-placeholder="" style="min-height:180px; padding:22px; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                  <span style="width:34px; height:34px; border-radius:999px; background:rgba(107,122,94,.12);"></span>
                  <div style="flex:1;">
                    <div style="width:52%; height:8px; background:rgba(43,43,43,.10); margin-bottom:7px;"></div>
                    <div style="width:26%; height:6px; background:rgba(43,43,43,.07);"></div>
                  </div>
                </div>
                <div style="letter-spacing:.12em; font-size:12px; color:#6B7A5E; margin-bottom:12px;">★★★★★</div>
                <div style="width:100%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:88%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:72%; height:7px; background:rgba(43,43,43,.08);"></div>
              </div>
            </article>
            <article data-google-review-placeholder="" style="min-height:180px; padding:22px; background:#FFFDF9; border:1px solid rgba(43,43,43,.08); display:flex; flex-direction:column; justify-content:space-between;">
              <div>
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                  <span style="width:34px; height:34px; border-radius:999px; background:rgba(107,122,94,.12);"></span>
                  <div style="flex:1;">
                    <div style="width:42%; height:8px; background:rgba(43,43,43,.10); margin-bottom:7px;"></div>
                    <div style="width:34%; height:6px; background:rgba(43,43,43,.07);"></div>
                  </div>
                </div>
                <div style="letter-spacing:.12em; font-size:12px; color:#6B7A5E; margin-bottom:12px;">★★★★★</div>
                <div style="width:96%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:84%; height:7px; background:rgba(43,43,43,.08); margin-bottom:8px;"></div>
                <div style="width:60%; height:7px; background:rgba(43,43,43,.08);"></div>
              </div>
            </article>
          </div>

          <p style="margin:16px 0 0; font-size:11px; line-height:1.6; color:rgba(43,43,43,.48);">
            Este bloque queda preparado para conectarse a la ficha de Google Business y reemplazar automáticamente estos espacios por reseñas reales.
          </p>
        </div>

    </section>
