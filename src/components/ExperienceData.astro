---
import type { Locale } from '@/content.config';
import type { ExperienceRecord } from '@/lib/experiences/catalog';

interface Props { locale: Locale; experiences: ExperienceRecord[] }
const { locale, experiences } = Astro.props;

/*
  Datos que el modal de detalle necesita en el navegador.

  En el bundle vivían en un objeto EXPERIENCE_DATA en español más un overlay
  EXPERIENCE_I18N, y el modal los mezclaba en tiempo de ejecución. Aquí la
  página ya está en un idioma, así que se sirve sólo ese: menos peso y una
  cosa menos que se pueda desincronizar.
*/
const data = Object.fromEntries(
  experiences.map((entry) => {
    const c = entry.content[locale];
    return [
      entry.slug,
      {
        title: c.title,
        lead: c.lead,
        body: c.body,
        facts: c.facts,
        includes: c.includes,
        excludes: c.excludes,
        modality: c.modality,
        note: c.note,
      },
    ];
  }),
);

const LABELS: Record<Locale, { modality: string; wa: string }> = {
  es: { modality: 'Modalidad:', wa: 'Hola, quiero información sobre {t} con PatagoniK.' },
  en: { modality: 'Format:', wa: 'Hi, I would like information about {t} with PatagoniK.' },
  pt: { modality: 'Modalidade:', wa: 'Olá, gostaria de informações sobre {t} com a PatagoniK.' },
};
const inlineJson = (value: unknown) => JSON.stringify(value)
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<script is:inline set:html={`
  window.__PK_EXPERIENCES = ${inlineJson(data)};
  window.__PK_LABELS = {
    modality: ${inlineJson(LABELS[locale].modality)},
    wa: function (t) { return ${inlineJson(LABELS[locale].wa)}.replace('{t}', t); }
  };
`} />
