---
import type { Locale } from '@/content.config';
import type { LandingAssetMap } from '@/lib/media/types';
import { localizedAlt } from '@/lib/media/types';
import { IMAGE_PRESETS, mediaImageSrcset, mediaImageUrl } from '@/lib/media/storage';
import type { ExperienceRecord } from '@/lib/experiences/catalog';

interface Props {
  locale: Locale;
  experiences: ExperienceRecord[];
  assets: LandingAssetMap;
}
const { locale, experiences, assets } = Astro.props;

const modalImage = (entry: ExperienceRecord) => {
  const content = entry.content[locale];
  const cover = assets[`experience.${entry.slug}.cover`];
  const selected = assets[`experience.${entry.slug}.modal`] ?? cover;
  if (!selected || selected.resourceType !== 'image') return null;
  const preset = IMAGE_PRESETS['experience-modal'];
  const focus = selected.focalPoint?.modal ?? selected.focalPoint?.desktop ?? selected.focalPoint;
  return {
    src: mediaImageUrl(selected, preset.widths[preset.widths.length - 1] ?? 1600, 'experience-modal') ?? selected.fallback,
    srcset: mediaImageSrcset(selected, 'experience-modal'),
    sizes: preset.sizes,
    alt: localizedAlt(selected, locale) || content.title,
    width: selected.width,
    height: selected.height,
    fit: selected.fitMode ?? 'cover',
    objectPosition: focus ? `${focus.x * 100}% ${focus.y * 100}%` : '50% 50%',
  };
};

const data = Object.fromEntries(
  experiences.map((entry) => {
    const c = entry.content[locale];
    return [
      entry.slug,
      {
        title: c.title,
        lead: c.lead,
        body: c.body,
        facts: c.facts,
        includes: c.includes,
        excludes: c.excludes,
        modality: c.modality,
        note: c.note,
        modalImage: modalImage(entry),
      },
    ];
  }),
);

const LABELS: Record<Locale, { modality: string; wa: string }> = {
  es: { modality: 'Modalidad:', wa: 'Hola, quiero información sobre {t} con PatagoniK.' },
  en: { modality: 'Format:', wa: 'Hi, I would like information about {t} with PatagoniK.' },
  pt: { modality: 'Modalidade:', wa: 'Olá, gostaria de informações sobre {t} com a PatagoniK.' },
};
const inlineJson = (value: unknown) => JSON.stringify(value)
  .replace(/</g, '\\u003c')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<script is:inline set:html={`
  window.__PK_EXPERIENCES = ${inlineJson(data)};
  window.__PK_LABELS = {
    modality: ${inlineJson(LABELS[locale].modality)},
    wa: function (t) { return ${inlineJson(LABELS[locale].wa)}.replace('{t}', t); }
  };
`} />