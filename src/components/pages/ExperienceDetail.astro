---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/content.config';
import { useTranslations, whatsappUrl } from '@/i18n';
import { routePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'experiences'>;
}
const { locale, entry } = Astro.props;
const c = entry.data.content[locale];
const t = useTranslations(locale);

const WA_ASK: Record<Locale, (title: string) => string> = {
  es: (title) => `Hola, quiero información sobre ${title} con PatagoniK.`,
  en: (title) => `Hi, I would like information about ${title} with PatagoniK.`,
  pt: (title) => `Olá, gostaria de informações sobre ${title} com a PatagoniK.`,
};
---

{/*
  En el bundle el detalle era un modal que se rellenaba por JS y no tenía URL
  propia indexable. Aquí cada experiencia es una página: comparte, entra desde
  buscador y funciona sin JavaScript.
*/}
<article class="pk-shell pk-detail" data-nav="light">
  <p class="pk-kicker">{t('exp.modal.kicker')}</p>
  <h1>{c.title}</h1>
  <p class="pk-detail__lead">{c.lead}</p>
  <p class="pk-detail__body">{c.body}</p>

  <dl class="pk-facts">
    {c.facts.map(([label, value]) => (
      <div>
        <dt>{label}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>

  <div class="pk-lists">
    <section>
      <h2>{t('exp.modal.includes')}</h2>
      <ul>{c.includes.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section>
      <h2>{t('exp.modal.excludes')}</h2>
      <ul>{c.excludes.map((item) => <li>{item}</li>)}</ul>
    </section>
  </div>

  <p class="pk-detail__modality"><strong>{t('exp.modal.modality')}</strong> {c.modality}</p>
  <p class="pk-detail__note">{c.note}</p>

  <p>
    <a class="pk-detail__cta" href={whatsappUrl(WA_ASK[locale](c.title))} target="_blank" rel="noopener">
      {t('exp.modal.cta')}
    </a>
  </p>
  <p><a href={routePath('experiences', locale)}>← {t('exp.back')}</a></p>
</article>

<style>
  .pk-detail {
    padding-block: clamp(40px, 7vw, 80px);
    max-width: 820px;
  }
  .pk-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pk-green);
    margin: 0 0 0.7rem;
  }
  .pk-detail h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  .pk-detail__lead {
    font-family: var(--pk-serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.4;
    color: var(--pk-green);
  }
  .pk-detail__body {
    line-height: 1.72;
    color: var(--pk-ink-soft);
  }
  .pk-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1px;
    background: rgba(43, 43, 43, 0.12);
    border: 1px solid rgba(43, 43, 43, 0.12);
    margin: 2rem 0;
  }
  .pk-facts > div {
    background: var(--pk-cream);
    padding: 14px 16px;
  }
  .pk-facts dt {
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.45);
    margin-bottom: 5px;
  }
  .pk-facts dd {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .pk-lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.6rem;
  }
  .pk-lists h2 {
    font-family: var(--pk-sans);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.5);
  }
  .pk-lists ul {
    margin: 0.6rem 0 0;
    padding-left: 18px;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .pk-detail__note {
    font-family: var(--pk-serif);
    font-style: italic;
    color: var(--pk-green);
    font-size: 1.1rem;
  }
  .pk-detail__cta {
    display: inline-block;
    background: var(--pk-green-deep);
    color: var(--pk-cream);
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
