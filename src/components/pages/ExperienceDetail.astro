---
import type { Locale } from '@/content.config';
import { useTranslations, whatsappUrl } from '@/i18n';
import { routePath } from '@/i18n/routes';
import type { ExperienceRecord } from '@/lib/experiences/catalog';
import type { LandingAssetMap } from '@/lib/media/types';
import StorageImage from '@/components/media/StorageImage.astro';

interface Props {
  locale: Locale;
  entry: ExperienceRecord;
  assets: LandingAssetMap;
}
const { locale, entry, assets } = Astro.props;
const c = entry.content[locale];
const t = useTranslations(locale);
const cover = assets[`experience.${entry.slug}.cover`];
if (!cover) throw new Error(`Asset requerido no encontrado: experience.${entry.slug}.cover`);

const modal = assets[`experience.${entry.slug}.modal`] ?? cover;
const galleryExtras = Object.entries(assets)
  .filter(([slotKey, asset]) => slotKey.startsWith(`experience.${entry.slug}.gallery.`) && asset.resourceType === 'image')
  .sort(([a], [b]) => {
    const aOrder = Number(a.split('.').at(-1) ?? 0);
    const bOrder = Number(b.split('.').at(-1) ?? 0);
    return aOrder - bOrder;
  })
  .map(([, asset]) => asset);
const gallery = [modal, ...galleryExtras].filter((asset, index, all) =>
  asset && all.findIndex((candidate) => candidate.slotKey === asset.slotKey) === index,
);

const WA_ASK: Record<Locale, (title: string) => string> = {
  es: (title) => `Hola, quiero información sobre ${title} con PatagoniK.`,
  en: (title) => `Hi, I would like information about ${title} with PatagoniK.`,
  pt: (title) => `Olá, gostaria de informações sobre ${title} com a PatagoniK.`,
};
---

<article class="pk-shell pk-detail" data-nav="light">
  <section class="pk-gallery" data-pk-gallery aria-label={t('exp.gallery.label')}>
    <div class="pk-gallery__track" data-gallery-track tabindex="0">
      {gallery.map((asset, index) => (
        <figure class="pk-gallery__slide" data-gallery-slide>
          <StorageImage
            asset={asset}
            locale={locale}
            preset="experience-detail"
            loading={index === 0 ? 'eager' : 'lazy'}
            alt={`${c.title} · ${index + 1}`}
          />
        </figure>
      ))}
    </div>
    {gallery.length > 1 && (
      <div class="pk-gallery__controls">
        <button type="button" data-gallery-prev aria-label={t('exp.gallery.previous')}>←</button>
        <span data-gallery-counter>1 / {gallery.length}</span>
        <button type="button" data-gallery-next aria-label={t('exp.gallery.next')}>→</button>
      </div>
    )}
  </section>

  <p class="pk-kicker">{t('exp.modal.kicker')}</p>
  <h1>{c.title}</h1>
  <p class="pk-detail__lead">{c.lead}</p>
  <p class="pk-detail__body">{c.body}</p>

  <dl class="pk-facts">
    {c.facts.map(([label, value]) => (
      <div>
        <dt>{label}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>

  <div class="pk-lists">
    <section>
      <h2>{t('exp.modal.includes')}</h2>
      <ul>{c.includes.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section>
      <h2>{t('exp.modal.excludes')}</h2>
      <ul>{c.excludes.map((item) => <li>{item}</li>)}</ul>
    </section>
  </div>

  <p class="pk-detail__modality"><strong>{t('exp.modal.modality')}</strong> {c.modality}</p>
  <p class="pk-detail__note">{c.note}</p>

  <p>
    <a class="pk-detail__cta" href={whatsappUrl(WA_ASK[locale](c.title))} target="_blank" rel="noopener">
      {t('exp.modal.cta')}
    </a>
  </p>
  <p><a href={routePath('experiences', locale)}>← {t('exp.back')}</a></p>
</article>

<script is:inline>
  document.querySelectorAll('[data-pk-gallery]').forEach((gallery) => {
    const track = gallery.querySelector('[data-gallery-track]');
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')];
    const previous = gallery.querySelector('[data-gallery-prev]');
    const next = gallery.querySelector('[data-gallery-next]');
    const counter = gallery.querySelector('[data-gallery-counter]');
    if (!track || !slides.length) return;
    let index = 0;
    const setIndex = (nextIndex, behavior = 'smooth') => {
      index = Math.max(0, Math.min(nextIndex, slides.length - 1));
      const target = slides[index];
      track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior });
      if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
    };
    previous?.addEventListener('click', () => setIndex(index - 1));
    next?.addEventListener('click', () => setIndex(index + 1));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); setIndex(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); setIndex(index + 1); }
    });
    track.addEventListener('scroll', () => {
      const nearest = slides.reduce((best, slide, slideIndex) => {
        const distance = Math.abs((slide.offsetLeft - track.scrollLeft) - track.offsetLeft);
        return distance < best.distance ? { distance, slideIndex } : best;
      }, { distance: Number.POSITIVE_INFINITY, slideIndex: 0 });
      if (nearest.slideIndex !== index) {
        index = nearest.slideIndex;
        if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      }
    }, { passive: true });
  });
</script>

<style>
  .pk-detail {
    padding-block: clamp(40px, 7vw, 80px);
    max-width: 820px;
  }
  .pk-gallery {
    margin: 0 0 clamp(30px, 6vw, 54px);
  }
  .pk-gallery__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    outline: none;
    background: #303833;
  }
  .pk-gallery__track::-webkit-scrollbar { display: none; }
  .pk-gallery__slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    scroll-snap-align: start;
    background: #303833;
  }
  .pk-gallery__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain !important;
    object-position: center !important;
    background: #303833;
  }
  .pk-gallery__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 12px;
    color: rgba(43, 43, 43, 0.58);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pk-gallery__controls button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(43, 43, 43, 0.18);
    border-radius: 50%;
    cursor: pointer;
    color: var(--pk-green-deep);
    background: transparent;
  }
  .pk-gallery__controls button:hover {
    color: var(--pk-cream);
    border-color: var(--pk-green-deep);
    background: var(--pk-green-deep);
  }
  .pk-detail__cover { display:none; }
  .pk-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pk-green);
    margin: 0 0 0.7rem;
  }
  .pk-detail h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  .pk-detail__lead {
    font-family: var(--pk-serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.4;
    color: var(--pk-green);
  }
  .pk-detail__body {
    line-height: 1.72;
    color: var(--pk-ink-soft);
  }
  .pk-facts {
    display: block;
    margin: clamp(2rem, 5vw, 3rem) 0;
    border-top: 1px solid rgba(43, 43, 43, 0.14);
    border-radius: 0 !important;
  }
  .pk-facts > div {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(18px, 4vw, 42px);
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(43, 43, 43, 0.14);
  }
  .pk-facts dt {
    padding-top: 2px;
    font-size: 0.58rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.48);
  }
  .pk-facts dd {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 450;
    line-height: 1.55;
    color: rgba(43, 43, 43, 0.88);
  }
  .pk-lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.6rem, 5vw, 3rem);
  }
  .pk-lists > section {
    padding: 18px 0 0;
    border: 0;
    border-top: 1px solid rgba(43, 43, 43, 0.14);
    border-radius: 0 !important;
    background: transparent;
  }
  .pk-lists h2 {
    font-family: var(--pk-sans);
    margin: 0 0 0.8rem;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.5);
  }
  .pk-lists ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(43, 43, 43, 0.76);
  }
  .pk-lists li {
    position: relative;
    padding-left: 15px;
  }
  .pk-lists li + li {
    margin-top: 7px;
  }
  .pk-lists li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--pk-green);
    content: '';
  }
  .pk-detail__note {
    font-family: var(--pk-serif);
    font-style: italic;
    color: var(--pk-green);
    font-size: 1.1rem;
  }
  .pk-detail__cta {
    display: inline-block;
    background: var(--pk-green-deep);
    color: var(--pk-cream);
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 620px) {
    .pk-facts > div {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }
  }
</style>