---
import type { Locale } from '@/content.config';
import { useTranslations, whatsappUrl } from '@/i18n';
import { routePath } from '@/i18n/routes';
import type { ExperienceRecord } from '@/lib/experiences/catalog';
import type { LandingAssetMap } from '@/lib/media/types';
import CloudinaryImage from '@/components/media/CloudinaryImage.astro';

interface Props {
  locale: Locale;
  entry: ExperienceRecord;
  assets: LandingAssetMap;
}
const { locale, entry, assets } = Astro.props;
const c = entry.content[locale];
const t = useTranslations(locale);
const cover = assets[`experience.${entry.slug}.cover`];
if (!cover) throw new Error(`Asset requerido no encontrado: experience.${entry.slug}.cover`);

const WA_ASK: Record<Locale, (title: string) => string> = {
  es: (title) => `Hola, quiero información sobre ${title} con PatagoniK.`,
  en: (title) => `Hi, I would like information about ${title} with PatagoniK.`,
  pt: (title) => `Olá, gostaria de informações sobre ${title} com a PatagoniK.`,
};
---

{/*
  En el bundle el detalle era un modal que se rellenaba por JS y no tenía URL
  propia indexable. Aquí cada experiencia es una página: comparte, entra desde
  buscador y funciona sin JavaScript.
*/}
<article class="pk-shell pk-detail" data-nav="light">
  <figure class="pk-detail__cover">
    <CloudinaryImage asset={cover} locale={locale} preset="experience-index" />
  </figure>
  <p class="pk-kicker">{t('exp.modal.kicker')}</p>
  <h1>{c.title}</h1>
  <p class="pk-detail__lead">{c.lead}</p>
  <p class="pk-detail__body">{c.body}</p>

  <dl class="pk-facts">
    {c.facts.map(([label, value]) => (
      <div>
        <dt>{label}</dt>
        <dd>{value}</dd>
      </div>
    ))}
  </dl>

  <div class="pk-lists">
    <section>
      <h2>{t('exp.modal.includes')}</h2>
      <ul>{c.includes.map((item) => <li>{item}</li>)}</ul>
    </section>
    <section>
      <h2>{t('exp.modal.excludes')}</h2>
      <ul>{c.excludes.map((item) => <li>{item}</li>)}</ul>
    </section>
  </div>

  <p class="pk-detail__modality"><strong>{t('exp.modal.modality')}</strong> {c.modality}</p>
  <p class="pk-detail__note">{c.note}</p>

  <p>
    <a class="pk-detail__cta" href={whatsappUrl(WA_ASK[locale](c.title))} target="_blank" rel="noopener">
      {t('exp.modal.cta')}
    </a>
  </p>
  <p><a href={routePath('experiences', locale)}>← {t('exp.back')}</a></p>
</article>

<style>
  .pk-detail {
    padding-block: clamp(40px, 7vw, 80px);
    max-width: 820px;
  }
  .pk-detail__cover {
    width: min(100%, 820px);
    aspect-ratio: 4 / 3;
    margin: 0 0 clamp(30px, 6vw, 54px);
    overflow: hidden;
    background: #303833;
  }
  .pk-detail__cover :global(image-slot),
  .pk-detail__cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pk-kicker {
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--pk-green);
    margin: 0 0 0.7rem;
  }
  .pk-detail h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
  }
  .pk-detail__lead {
    font-family: var(--pk-serif);
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.4;
    color: var(--pk-green);
  }
  .pk-detail__body {
    line-height: 1.72;
    color: var(--pk-ink-soft);
  }
  .pk-facts {
    display: block;
    margin: clamp(2rem, 5vw, 3rem) 0;
    border-top: 1px solid rgba(43, 43, 43, 0.14);
    border-radius: 0 !important;
  }
  .pk-facts > div {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(18px, 4vw, 42px);
    align-items: start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(43, 43, 43, 0.14);
  }
  .pk-facts dt {
    padding-top: 2px;
    font-size: 0.58rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.48);
  }
  .pk-facts dd {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 450;
    line-height: 1.55;
    color: rgba(43, 43, 43, 0.88);
  }
  .pk-lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.6rem, 5vw, 3rem);
  }
  .pk-lists > section {
    padding: 18px 0 0;
    border: 0;
    border-top: 1px solid rgba(43, 43, 43, 0.14);
    border-radius: 0 !important;
    background: transparent;
  }
  .pk-lists h2 {
    font-family: var(--pk-sans);
    margin: 0 0 0.8rem;
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(43, 43, 43, 0.5);
  }
  .pk-lists ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(43, 43, 43, 0.76);
  }
  .pk-lists li {
    position: relative;
    padding-left: 15px;
  }
  .pk-lists li + li {
    margin-top: 7px;
  }
  .pk-lists li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--pk-green);
    content: '';
  }
  .pk-detail__note {
    font-family: var(--pk-serif);
    font-style: italic;
    color: var(--pk-green);
    font-size: 1.1rem;
  }
  .pk-detail__cta {
    display: inline-block;
    background: var(--pk-green-deep);
    color: var(--pk-cream);
    padding: 0.9rem 1.3rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 620px) {
    .pk-facts > div {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 14px 0;
    }
  }
</style>
