---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/content.config';
import { useTranslations } from '@/i18n';
import { experiencePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  experiences: CollectionEntry<'experiences'>[];
}
const { locale, experiences } = Astro.props;
const t = useTranslations(locale);
---

{/*
  Catálogo completo. En la portada las experiencias viven en un carrusel, que
  sirve para descubrir pero no para comparar ni para llegar desde un buscador.
  Aquí están las dieciséis a la vez, cada una con su enlace propio.
*/}
<section class="pk-index" data-nav="light">
  <header class="pk-index__head">
    <p class="pk-index__kicker">{t('exp.index.kicker')}</p>
    <h1>{t('exp.index.title')}</h1>
    <p class="pk-index__intro">{t('exp.index.intro')}</p>
  </header>

  <ul class="pk-index__grid">
    {
      experiences.map((entry) => {
        const c = entry.data.content[locale];
        return (
          <li class="pk-index__item">
            <a href={experiencePath(entry.data.slug, locale)}>
              <span class="pk-index__media">
                <img src={`/images/exp-${entry.data.order}.webp`} alt="" loading="lazy" decoding="async" />
              </span>
              <span class="pk-index__body">
                {c.cardCategory && <span class="pk-index__cat">{c.cardCategory}</span>}
                <h2>{c.cardTitle}</h2>
                <span class="pk-index__summary">{c.cardSummary}</span>
                <span class="pk-index__meta">{c.cardDetail}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .pk-index {
    background: #f5f2ec;
    padding: clamp(72px, 12vh, 130px) clamp(22px, 6vw, 96px) clamp(60px, 10vw, 110px);
  }
  .pk-index__head {
    max-width: 1180px;
    margin: 0 auto clamp(34px, 6vw, 62px);
  }
  .pk-index__kicker {
    margin: 0 0 12px;
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #6b7a5e;
  }
  .pk-index h1 {
    margin: 0;
    font-family: var(--pk-catalog-serif, Georgia, serif);
    font-weight: 300;
    font-size: clamp(34px, 6vw, 62px);
    line-height: 1.02;
    color: #2b2b2b;
  }
  .pk-index__intro {
    margin: 18px 0 0;
    max-width: 58ch;
    font-size: 15px;
    line-height: 1.72;
    font-weight: 300;
    color: rgba(43, 43, 43, 0.68);
  }
  .pk-index__grid {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(18px, 2.4vw, 32px);
    grid-template-columns: repeat(auto-fill, minmax(258px, 1fr));
  }
  .pk-index__item a {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #f5f2ec;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(57, 67, 62, 0.94) 0%, rgba(36, 43, 39, 0.97) 100%);
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.4s ease;
  }
  .pk-index__item a:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 44px rgba(24, 30, 27, 0.22);
  }
  .pk-index__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #2f3632;
  }
  .pk-index__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pk-index__body {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 15px 17px 20px;
  }
  .pk-index__cat {
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.62);
  }
  .pk-index h2 {
    margin: 0;
    font-family: var(--pk-catalog-serif, Georgia, serif);
    font-weight: 300;
    font-size: clamp(20px, 1.7vw, 25px);
    line-height: 1.1;
  }
  .pk-index__summary {
    font-size: 12px;
    line-height: 1.46;
    font-weight: 300;
    color: rgba(245, 242, 236, 0.8);
  }
  .pk-index__meta {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 242, 236, 0.6);
  }
</style>
