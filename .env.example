# Variables públicas (también disponibles en el navegador)
PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
PUBLIC_SUPABASE_STORAGE_BUCKET=patagonik-media
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Variables privadas: sólo Vercel/API/build, nunca PUBLIC_*
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
SUPABASE_STORAGE_BUCKET=patagonik-media
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/REEMPLAZAR
CRON_SECRET=generar_un_valor_largo_y_aleatorio

# Traducción automática (recomendado: OpenCode Zen).
TRANSLATION_PROVIDER=opencode-zen
TRANSLATION_API_KEY=REEMPLAZAR_CON_KEY_DE_OPENCODE
TRANSLATION_MODEL=gpt-5.6-luna
# Opcional: se infiere por modelo. Valores: responses | chat-completions
# TRANSLATION_API_FORMAT=responses

# Para un modelo gratuito temporal de OpenCode Zen:
# TRANSLATION_MODEL=mimo-v2.5-free
# TRANSLATION_API_FORMAT=chat-completions

# Alternativa compatible con la configuración anterior:
# TRANSLATION_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-REEMPLAZAR
# OPENAI_TRANSLATION_MODEL=gpt-5.6-luna

# Opcional: hace fallar el build si Supabase no responde, en vez de usar locales.
# Activarlo sólo después de migrar y verificar todos los slots.
MEDIA_REMOTE_REQUIRED=false
# Opcional: exige que el orden/contenido publicado venga de Supabase.
EXPERIENCES_REMOTE_REQUIRED=false

# Sólo para scripts locales/Actions. No va en Vercel.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Google Places API (New): configuration is used only by the server
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
